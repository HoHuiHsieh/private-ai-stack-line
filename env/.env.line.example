# Template for .env.line. Copy to .env.line and fill in the values. Never commit the filled-in file.
# Settings for the line container (loaded after the root .env).

# Shared secret with agent-service (INTERNAL_API_TOKEN there). Must match exactly.
INTERNAL_API_TOKEN=

# Same database and key as agent-service: LINE credentials and chat mappings live in its secrets table.
AGENT_DATABASE_URL=
PG_POOL_MAX=
SECRETS_ENCRYPTION_KEY=

# Keycloak JWT checks for the MCP endpoint (same values as agent-service).
MCP_JWKS_URL=
MCP_JWT_ISSUER=
MCP_JWT_AUDIENCE=
OIDC_ISSUER=
APP_PUBLIC_URL=

# Open WebUI (internal URL) and the LINE bot's tuning.
OPEN_WEBUI_URL=http://open-webui:3000
LINE_MAX_HISTORY_MESSAGES=
NGROK_API_URL=http://ngrok:4040

# Models (chat, audio, ...) are configured in models.json, not here.
